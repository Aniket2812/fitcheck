# Never commit the real .env — it is gitignored.
OPENAI_API_KEY=sk-...

# openai (default) | youcam
PORT=8787

# Perfect Corp YouCam AI Clothes v3. The API key is used as the v2 bearer
# token; the secret is retained server-side for account/webhook integrations.
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
YOUCAM_TIMEOUT_MS=180000
YOUCAM_POLL_MS=2000

# Stage limits. The Flutter client waits 390s so the server always responds
# first with a useful provider/stage error.
OPENAI_CUTOUT_TIMEOUT_MS=240000
OPENAI_METADATA_TIMEOUT_MS=45000
OPENAI_RESEARCH_TIMEOUT_MS=100000
IMAGE_DOWNLOAD_TIMEOUT_MS=30000
OPENAI_RESEARCH_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_FORMAT=webp
OPENAI_IMAGE_COMPRESSION=80
OPENAI_IMAGE_CACHE_SIZE=32

# Google Sign-In. Set to the OAuth *web* client id (comma-separate the iOS and
# Android ones too if their tokens reach this server). While unset, the server
# runs in dev mode and accepts the client's `dev:` stand-in sign-in.
GOOGLE_CLIENT_ID=

# The demo feed is persisted into DATA_FILE on first startup. Disable it for
# an empty production database.
SEED_DEMO_DATA=true
